{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs-quality/7",
  "title": "Оценка качества одного документа: бизнес-требований или тех-спеки",
  "description": "Один документ — один файл <имя документа>.quality.json рядом с ним. Баллы и находки с цитатами даёт модель по рубрике; балл полноты структуры, суммы, проценты, подсветку и происхождение считает скрипт merge. Правила, которые схемой не выразить (суммы, балл полноты структуры, шкала балла, причины подсветки, находки ровно у сниженных критериев, веса того же вида), проверяет contract.py. Сводку по автору собирает дашборд: Σ sum / Σ max, разделы структуры — по structure_missing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "params", "document"],
  "properties": {
    "schema": {"const": "specs-quality/7"},
    "generated_at": {"type": "string", "format": "date-time"},
    "params": {"$ref": "#/$defs/params"},
    "document": {"$ref": "#/$defs/document"}
  },
  "$defs": {
    "path": {"description": "Путь от корня, через «/».", "type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "nullable_text": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "nullable_string": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "weight": {"type": "number", "exclusiveMinimum": 0},
    "score": {"description": "Балл с весом: 0, половина веса или вес; null — не применимо («н/п»), причина — в findings этого критерия.", "type": ["number", "null"], "minimum": 0},

    "params": {
      "description": "Параметры, с которыми посчитан документ, — для его вида (из params.json или --params).",
      "type": "object",
      "additionalProperties": false,
      "required": ["below_pct", "structure_min_missing", "weights", "structure_weight"],
      "properties": {
        "below_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "structure_min_missing": {"description": "С какого числа пропущенных разделов шаблона у документа «неполная структура»: у БТ из 16, у спеки из 23.",
                             "type": "integer", "minimum": 1, "maximum": 23},
        "weights": {"description": "Вес каждого критерия рубрики этого вида.", "oneOf": [{"$ref": "#/$defs/weights_bt"}, {"$ref": "#/$defs/weights_spec"}]},
        "structure_weight": {"description": "Вес «Полноты структуры» в итоге: structure_score = доля разделов на месте × вес.", "$ref": "#/$defs/weight"}
      }
    },
    "weights_bt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["necessity", "entities", "unambiguity", "verifiability", "actors", "scope", "consistency"],
      "properties": {"necessity": {"$ref": "#/$defs/weight"}, "entities": {"$ref": "#/$defs/weight"}, "unambiguity": {"$ref": "#/$defs/weight"},
                     "verifiability": {"$ref": "#/$defs/weight"}, "actors": {"$ref": "#/$defs/weight"}, "scope": {"$ref": "#/$defs/weight"},
                     "consistency": {"$ref": "#/$defs/weight"}}
    },
    "weights_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceability", "data_model", "security", "impact", "interfaces", "consistency"],
      "properties": {"traceability": {"$ref": "#/$defs/weight"}, "data_model": {"$ref": "#/$defs/weight"}, "security": {"$ref": "#/$defs/weight"},
                     "impact": {"$ref": "#/$defs/weight"}, "interfaces": {"$ref": "#/$defs/weight"}, "consistency": {"$ref": "#/$defs/weight"}}
    },

    "criteria_bt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["necessity", "entities", "unambiguity", "verifiability", "actors", "scope", "consistency"],
      "properties": {"necessity": {"$ref": "#/$defs/score"}, "entities": {"$ref": "#/$defs/score"}, "unambiguity": {"$ref": "#/$defs/score"},
                     "verifiability": {"$ref": "#/$defs/score"}, "actors": {"$ref": "#/$defs/score"}, "scope": {"$ref": "#/$defs/score"},
                     "consistency": {"$ref": "#/$defs/score"}}
    },
    "criteria_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceability", "data_model", "security", "impact", "interfaces", "consistency"],
      "properties": {"traceability": {"$ref": "#/$defs/score"}, "data_model": {"$ref": "#/$defs/score"}, "security": {"$ref": "#/$defs/score"},
                     "impact": {"$ref": "#/$defs/score"}, "interfaces": {"$ref": "#/$defs/score"}, "consistency": {"$ref": "#/$defs/score"}}
    },

    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "repo", "kind", "key", "feature", "author", "source", "scored"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "repo": {"description": "Репозиторий, если передали при запуске; нет — null.", "$ref": "#/$defs/nullable_string"},
        "kind": {"enum": ["bt", "spec"]},
        "key": {"description": "Ключ задачи из шапки; нет — имя папки, у узла-фундамента — имя папки эпика.", "type": "string", "minLength": 1},
        "feature": {"$ref": "#/$defs/nullable_string"},
        "author": {"description": "Строка «Автор» из шапки; нет — null.", "$ref": "#/$defs/nullable_string"},
        "source": {"description": "У спеки — документ сверху (БТ, баг-репорт, запрос на правку); нет или узел-фундамент — null. У БТ — null.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "scored": {"description": "false — оценка не состоялась.", "type": "boolean"},
        "skip_reason": {"$ref": "#/$defs/text"},
        "pct": {"description": "sum / max × 100 с округлением до целого; max = 0 — null.", "type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "sum": {"description": "Баллы критериев плюс structure_score.", "type": "number", "minimum": 0},
        "max": {"description": "Сумма весов критериев без «н/п» плюс вес полноты структуры, если структура проверена.", "type": "number", "minimum": 0},
        "criteria": {"description": "Критерий → балл, по порядку рубрики.", "oneOf": [{"$ref": "#/$defs/criteria_bt"}, {"$ref": "#/$defs/criteria_spec"}]},
        "attention": {"description": "Причины «требует внимания»; пусто — не требует.", "type": "array",
                      "items": {"enum": ["below_pct", "zero", "template", "off_structure"]}},
        "template": {"description": "Заполнено шаблонно.", "type": "boolean"},
        "structure_missing": {"description": "Номера разделов списка «Форма» рубрики без своего заголовка; null — модель не вернула блок «Форма».",
                         "oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "integer", "minimum": 1}}]},
        "structure_pct": {"description": "«Полнота структуры» в процентах: доля разделов шаблона на месте; структура не проверена — null.", "type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "structure_score": {"description": "«Полнота структуры» в итоге: доля разделов на месте × params.structure_weight, до сотых; структура не проверена — null.",
                       "type": ["number", "null"], "minimum": 0},
        "origin": {"description": "Только у спеки: by_code — по готовому коду (два разных признака кода, среди них «уже сделано»: 1, 3 или 6), skill — скиллом, skill_edited — скиллом и руками, outside — мимо фреймворка.",
                   "oneOf": [{"type": "null"}, {"enum": ["by_code", "skill", "skill_edited", "outside"]}]},
        "code_signs": {"description": "Только у спеки, у БТ — null: признаки кода, что выписал оценщик, — доказательства для origin. «По коду» — два разных номера, среди них 1, 3 или 6.",
                       "oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/code_sign"}}]},
        "findings": {"description": "По строке на сниженный или «н/п» критерий рубрики, по её порядку.",
                     "type": "array", "items": {"$ref": "#/$defs/finding"}}
      },
      "allOf": [
        {"if": {"properties": {"scored": {"const": false}}},
         "then": {"required": ["skip_reason"],
                  "allOf": [{"not": {"required": ["criteria"]}}, {"not": {"required": ["pct"]}}, {"not": {"required": ["findings"]}},
                            {"not": {"required": ["attention"]}}]}},
        {"if": {"properties": {"scored": {"const": true}}},
         "then": {"required": ["pct", "sum", "max", "criteria", "attention", "template", "structure_missing", "structure_pct", "structure_score", "origin",
                               "code_signs", "findings"],
                  "not": {"required": ["skip_reason"]}}}
      ]
    },

    "code_sign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "kind", "quote"],
      "properties": {
        "n": {"description": "Номер признака из списка рубрики спеки.", "type": "integer", "minimum": 1, "maximum": 6},
        "kind": {"enum": ["сделано в коде", "путь к исходнику", "объём правки в строках", "рефакторинг или тесты", "миграция или changelog", "закрытое изменение источником"]},
        "quote": {"$ref": "#/$defs/text"},
        "quote_found": {"description": "Есть только если цитаты нет в тексте документа.", "const": false}
      }
    },

    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "comment", "fix", "quote"],
      "properties": {
        "criterion": {"description": "Критерий рубрики.", "type": "string", "minLength": 1},
        "comment": {"description": "Что не так, или причина «н/п»; где искал — в скобках.", "$ref": "#/$defs/nullable_text"},
        "fix": {"description": "Что подняло бы балл.", "$ref": "#/$defs/nullable_text"},
        "quote": {"description": "Раздел и цитата: «§3.2: «…»»; у consistency — две цитаты через « ↔ ».", "$ref": "#/$defs/nullable_text"},
        "quote_found": {"description": "Есть только если цитаты нет в тексте документа; балл от этого не меняется.", "const": false}
      }
    }
  }
}
