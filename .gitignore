# Рабочий каталог артефактов пользователя (создаётся при запуске скиллов)
product/

# Системный/редакторский мусор
.DS_Store
Thumbs.db
*.log

# Node (на случай локальной установки impeccable)
node_modules/

# Песочницы прогонов и вывод самотестов: пересоздаются скриптами _skill-eval
# (setup-*.mjs копирует фикстуры, selftest-*.mjs пишет свой материал сам).
# В репозитории от прогона остаются STATE.md, PROMPTS.md и GRADE-REPORT.txt.
# `before/` — снимок скилла до правки для A/B: 140 КБ дубля, run.sh достаёт его
# из git по зафиксированному коммиту, поэтому в репозитории ему делать нечего.
**/_skill-eval/runs/*/*/eval-*/
**/_skill-eval/runs/*/sandbox*/
**/_skill-eval/runs/*/before/
# Плечи `run-pool.sh` и песочницы `run-ctx.sh` — один шаблон на оба случая.
# У `run-pool.sh` имя плеча своё у каждого раунда (`bs1-after/run-01`, `gui4/run-03`),
# у `run-ctx.sh` раскладка плоская (`runs/<раунд>/<проба>/run-NN/`) — ловим по имени
# песочницы, а не плеча. В репозитории от раунда остаются журналы и `_commit.txt`,
# сами песочницы пересоздаются.
**/_skill-eval/runs/**/run-*/
# Снимки скиллов раунда — копия текста, который и так в git (по коммиту из `_commit.txt`);
# ~200 КБ на раунд, на 2026-11-22 — 87 % веса runs/. Редакцию, которой нет ни в одном
# коммите (промежуточную), добавлять вручную: `git add -f <раунд>/_skills/<скилл>.SKILL.md`.
# Снимки до 2026-11-22 — в теге archive/runs-2026-11-22.
**/_skill-eval/runs/**/_skills/
**/_skill-eval/selftest/

# Вывод генераторов фикстур (NRS-TAIL/make.sh и подобные): дерево пересоздаётся скриптом,
# в репозитории лежит только сам скрипт и README.
**/_skill-eval/fixtures/*/out/
# Снимок скилла «до» для A/B: достаётся из git по коммиту, записанному в STATE.md раунда.
**/_skill-eval/runs/*/_src-base/

# Убитые и пробные раунды стенда: песочницы, перенесённые в `_killed-*/` (rm на стенде
# запрещён, поэтому mv), и сухие прогоны `_dry-*/`. Чисел из них нет, в репозитории им делать нечего.
**/_skill-eval/runs/_killed-*/
**/_skill-eval/runs/_dry-*/

# Прогоны стенда manager-version (session-quality, specs-quality): ответы модели, потоки ведущего,
# снимки скилла — десятки мегабайт, в репозиторий не идут; числа записаны в планах.
manager-version/_skill-eval/runs/

# Полевые логи и карточки с прода, присланные для разбора: лежат в корне и в oldlogs/,
# в репозиторий не идут (внутренний код заказчика).
/oldlogs/
/*.txt

# Кэш Python от скриптов скиллов и стенда
__pycache__/
